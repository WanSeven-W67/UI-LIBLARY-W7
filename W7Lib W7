    local MinCorner = Instance.new("UICorner")
    MinCorner.CornerRadius = UDim.new(1, 0)
    MinCorner.Parent = MinBtn
    local FloatBtnTrigger = Instance.new("TextButton")
    FloatBtnTrigger.Name = "FloatBtnTrigger"
    FloatBtnTrigger.Parent = TopBar
    FloatBtnTrigger.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
    FloatBtnTrigger.Position = UDim2.new(1, -64, 0.22, 0)
    FloatBtnTrigger.Size = UDim2.new(0, 24, 0, 24)
    FloatBtnTrigger.Text = "o"
    FloatBtnTrigger.Font = Enum.Font.GothamBold
    FloatBtnTrigger.TextColor3 = Color3.fromRGB(255, 255, 255)
    FloatBtnTrigger.TextSize = 13

    local FloatTriggerCorner = Instance.new("UICorner")
    FloatTriggerCorner.CornerRadius = UDim.new(1, 0)
    FloatTriggerCorner.Parent = FloatBtnTrigger

    local FloatingButton = Instance.new("TextButton")
    FloatingButton.Name = "W7_FloatingButton"
    FloatingButton.Parent = ScreenGui
    FloatingButton.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    FloatingButton.Position = UDim2.new(0.05, 0, 0.2, 0)
    FloatingButton.Size = UDim2.new(0, 46, 0, 46)
    FloatingButton.Text = "W7"
    FloatingButton.Font = Enum.Font.GothamBold
    FloatingButton.TextColor3 = Color3.fromRGB(unpack(Config.ThemeColor))
    FloatingButton.TextSize = 15
    FloatingButton.Visible = false
    FloatingButton.ZIndex = 10

    local FloatCorner = Instance.new("UICorner")
    FloatCorner.CornerRadius = UDim.new(1, 0)
    FloatCorner.Parent = FloatingButton

    local FloatStroke = Instance.new("UIStroke")
    FloatStroke.Color = Color3.fromRGB(unpack(Config.ThemeColor))
    FloatStroke.Thickness = 2
    FloatStroke.Parent = FloatingButton
    RegisterThemedColor(function()
        FloatStroke.Color = Color3.fromRGB(unpack(Config.ThemeColor))
        FloatingButton.TextColor3 = Color3.fromRGB(unpack(Config.ThemeColor))
    end)

    FloatBtnTrigger.MouseButton1Click:Connect(function()
        PlayClickSound()
        MainFrame.Visible = false
        FloatingButton.Visible = true
    end)

    FloatingButton.MouseButton1Click:Connect(function()
        PlayClickSound()
        FloatingButton.Visible = false
        MainFrame.Visible = true
    end)

    local fDragging, fDragInput, fDragStart, fStartPos
    FloatingButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            fDragging = true; fDragStart = input.Position; fStartPos = FloatingButton.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then fDragging = false end
            end)
        end
    end)
    FloatingButton.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then fDragInput = input end
    end)
    TrackConnection(UserInputService.InputChanged:Connect(function(input)
        if input == fDragInput and fDragging then
            local delta = input.Position - fDragStart
            FloatingButton.Position = UDim2.new(fStartPos.X.Scale, fStartPos.X.Offset + delta.X, fStartPos.Y.Scale, fStartPos.Y.Offset + delta.Y)
        end
    end))

    local minimized = false
    MinBtn.MouseButton1Click:Connect(function()
        PlayClickSound()
        if not minimized then
            TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, MainFrame.Size.X.Offset, 0, 42)}):Play()
            MinBtn.Text = "+"
            minimized = true
        else
            TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, MainFrame.Size.X.Offset, 0, Config.Height)}):Play()
            MinBtn.Text = "-"
            minimized = false
        end
    end)

    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
