function W7Lib:CreateWindow(judulScript)
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "W7_Premium_Lib"
    ScreenGui.Parent = PlayerGui
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.DisplayOrder = 1000 -- angka gede = digambar paling atas dibanding GUI lain

    local CurrentScreenSize = ScreenGui.AbsoluteSize
    local baseWidth = math.clamp(CurrentScreenSize.X * 0.45, 330, 480)
    local baseHeight = math.clamp(CurrentScreenSize.Y * 0.55, 230, 320)

    local SaveFile = "W7_Config_Cache.json"
    local Config = {
        Width = baseWidth,
        Height = baseHeight,
        ThemeColor = {0, 170, 255},
        PanelColor = {24, 24, 32},
        BgImage = "",
        SoundEnabled = true,
        SoundOnId = "rbxassetid://9114223161",
        SoundOffId = "rbxassetid://9114233671",
        FontName = "GothamMedium", -- disimpan sebagai string biar aman di-JSON-encode
        WatermarkVisible = true,
        FPSBoost = false,
        Shortcuts = {}, -- [namaFitur] = {pos = {xScale,xOffset,yScale,yOffset}}
        SavedFeatures = {}, -- [namaFitur] = value (diisi manual lewat Window:SaveState())
        Profiles = {} -- [namaProfile] = {SavedFeatures=..., ThemeColor=..., PanelColor=...}
    }

    if readfile and isfile and isfile(SaveFile) then
        pcall(function()
            local decoded = HttpService:JSONDecode(readfile(SaveFile))
            for k, v in pairs(decoded) do Config[k] = v end
        end)
    end
    Config.Shortcuts = Config.Shortcuts or {}
    Config.SavedFeatures = Config.SavedFeatures or {}
    Config.Profiles = Config.Profiles or {}

    -- ================================
    -- LOG SYSTEM (buat Debug Console Mini) -- dipindah ke awal biar StateRegistry bisa pakai buat warning
    -- ================================
    local LogEntries = {} -- {text=..., level=...}
    local LogListeners = {} -- fungsi yang dipanggil tiap ada log baru (dipakai CreateConsole)
    local MAX_LOG_ENTRIES = 60
    local NotifyBridge = {fn = nil} -- diisi belakangan setelah Window:Notify didefinisikan

    local function EmitLog(text, level)
        level = level or "info"
        table.insert(LogEntries, {text = text, level = level})
        if #LogEntries > MAX_LOG_ENTRIES then table.remove(LogEntries, 1) end
        for _, listener in ipairs(LogListeners) do
            pcall(listener, text, level)
        end
        if level == "error" and NotifyBridge.fn then
            pcall(NotifyBridge.fn, "Error", text, 4)
        end
    end

    -- Bungkus callback biar kalau error, otomatis ke-catat ke Debug Console + toast merah
    -- (dipakai internal di semua komponen, tapi bisa juga dipakai manual kalau perlu)
    local function SafeFire(sourceName, fn, ...)
        local args = {...}
        task.spawn(function()
            local ok, err = pcall(fn, table.unpack(args))
            if not ok then
                EmitLog("Error di \"" .. sourceName .. "\": " .. tostring(err), "error")
            end
        end)
    end

    -- ================================
    -- STATE REGISTRY (Save/Load MANUAL -- bukan auto-save)
    -- ================================
    local StateRegistry = {} -- [name] = {get=fn, set=fn, default=value}

    local function RegisterState(name, getFn, setFn, defaultValue)
        if StateRegistry[name] then
            EmitLog("Nama fitur \"" .. name .. "\" dipakai lebih dari sekali -- data save/state-nya bakal saling menimpa. Kasih nama unik biar aman.", "warn")
        end
        StateRegistry[name] = {get = getFn, set = setFn, default = defaultValue}
    end

    -- ================================
    -- NOTIFICATION / TOAST GUI
    -- ================================
    local NotifyGui = Instance.new("ScreenGui")
    NotifyGui.Name = "W7_NotifyGui"
    NotifyGui.Parent = PlayerGui
    NotifyGui.ResetOnSpawn = false
    NotifyGui.IgnoreGuiInset = true
    NotifyGui.DisplayOrder = 1001 -- paling atas dari semua (toast harus selalu keliatan)

    local NotifyHolder = Instance.new("Frame")
    NotifyHolder.Name = "Holder"
    NotifyHolder.BackgroundTransparency = 1
    NotifyHolder.Size = UDim2.new(0, 260, 1, -20)
    NotifyHolder.Position = UDim2.new(1, -270, 0, 10)
    NotifyHolder.Parent = NotifyGui

    local NotifyList = Instance.new("UIListLayout")
    NotifyList.Parent = NotifyHolder
    NotifyList.Padding = UDim.new(0, 8)
    NotifyList.HorizontalAlignment = Enum.HorizontalAlignment.Right
    NotifyList.VerticalAlignment = Enum.VerticalAlignment.Top
    NotifyList.SortOrder = Enum.SortOrder.LayoutOrder

    local function SaveConfig()
        if writefile then
            pcall(function() writefile(SaveFile, HttpService:JSONEncode(Config)) end)
        end
    end

    -- ================================
    -- CONNECTION TRACKING (dipindah ke paling awal biar bisa dipakai dari mana aja,
    -- termasuk koneksi global UserInputService/RunService yang dibuat sebelum WindowFunctions ada)
    -- ================================
    local connections = {}
    local function TrackConnection(conn)
        table.insert(connections, conn)
        return conn
    end

    local function PlayClickSound(variant)
        if not Config.SoundEnabled then return end
        local sound = Instance.new("Sound")
        if variant == "on" then
            sound.SoundId = Config.SoundOnId
        elseif variant == "off" then
            sound.SoundId = Config.SoundOffId
        else
            sound.SoundId = Config.SoundOnId
        end
        sound.Volume = 1
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        game:GetService("Debris"):AddItem(sound, 1)
    end

    -- ================================
    -- THEME API
    -- Level 1: Window:SetTheme({AccentColor=Color3, PanelColor=Color3}) -> ganti tema global, live update
    -- Level 2: tiap komponen bisa dikasih parameter "options" berisi AccentColor sendiri -> override, nggak ikut tema global
    -- ================================
    local ThemeRegistry = {}
    local FontRegistry = {}

    local function RegisterThemedColor(refreshFn)
        table.insert(ThemeRegistry, refreshFn)
        return refreshFn
    end

    local function RegisterThemedFont(refreshFn)
        table.insert(FontRegistry, refreshFn)
        return refreshFn
    end

    -- Ambil Enum.Font sekarang dari Config.FontName (string), fallback ke GothamMedium kalau nama salah/nggak ada
    local function GetFont()
        local ok, result = pcall(function() return Enum.Font[Config.FontName] end)
        if ok and result then return result end
        return Enum.Font.GothamMedium
    end

    -- ================================
    -- SHORTCUT MANAGER (Universal: Mouse & Touch = HP + PC otomatis jalan)
    -- ================================
    local ActiveShortcuts = {} -- [name] = {frame=..., conn=...}

    -- name: nama unik fitur | icon: emoji/text kecil | isOnFn: function() return state end | toggleFn: function() -- ganti state
    local function ToggleShortcutButton(name, icon, isOnFn, toggleFn)
        if ActiveShortcuts[name] then
            if ActiveShortcuts[name].conn then ActiveShortcuts[name].conn:Disconnect() end
            ActiveShortcuts[name].frame:Destroy()
            ActiveShortcuts[name] = nil
            return
        end

        Config.Shortcuts[name] = Config.Shortcuts[name] or {}

        local frame = Instance.new("Frame")
        frame.Name = "Shortcut_" .. name
        frame.Size = UDim2.new(0, 120, 0, 56)
        frame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
        frame.Active = true
        frame.Parent = ShortcutGui

        local savedPos = Config.Shortcuts[name].pos
        if savedPos then
            frame.Position = UDim2.new(savedPos[1], savedPos[2], savedPos[3], savedPos[4])
        else
            frame.Position = UDim2.new(0.5, -60, 0.5, -28)
        end

        local locked = Config.Shortcuts[name].locked or false

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = frame

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1.5
        stroke.Parent = frame

        local nameLabel = Instance.new("TextLabel")
        nameLabel.BackgroundTransparency = 1
        nameLabel.Size = UDim2.new(1, -8, 0, 24)
        nameLabel.Position = UDim2.new(0, 4, 0, 2)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Text = icon .. " " .. name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextSize = 11
        nameLabel.TextWrapped = true
        nameLabel.Parent = frame

        local stateLabel = Instance.new("TextLabel")
        stateLabel.BackgroundTransparency = 1
        stateLabel.Size = UDim2.new(1, 0, 0, 20)
        stateLabel.Position = UDim2.new(0, 0, 0, 28)
        stateLabel.Font = Enum.Font.GothamBold
        stateLabel.TextSize = 13
        stateLabel.Parent = frame

        -- Tombol kunci kecil di pojok kanan atas -- kalau dikunci, nggak bisa digeser lagi
        local LockBtn = Instance.new("TextButton")
        LockBtn.Size = UDim2.new(0, 16, 0, 16)
        LockBtn.Position = UDim2.new(1, -18, 0, 2)
        LockBtn.BackgroundTransparency = 1
        LockBtn.Font = Enum.Font.GothamBold
        LockBtn.Text = locked and "L" or "U"
        LockBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
        LockBtn.TextSize = 10
        LockBtn.ZIndex = 6
        LockBtn.Parent = frame

        LockBtn.MouseButton1Click:Connect(function()
            locked = not locked
            LockBtn.Text = locked and "L" or "U"
            Config.Shortcuts[name].locked = locked
            SaveConfig()
        end)

        local clickBtn = Instance.new("TextButton")
        clickBtn.BackgroundTransparency = 1
        clickBtn.Size = UDim2.new(1, 0, 1, 0)
        clickBtn.Text = ""
        clickBtn.ZIndex = 5
        clickBtn.Active = true
        clickBtn.Parent = frame

        -- Glow: stroke berdenyut pelan pas fitur lagi ON, biar keliatan "hidup"
        local glowTween = TweenService:Create(stroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Thickness = 3})

        local function RefreshVisual()
            local state = isOnFn()
            stateLabel.Text = state and "ON" or "OFF"
            stateLabel.TextColor3 = state and Color3.fromRGB(unpack(Config.ThemeColor)) or Color3.fromRGB(150, 150, 155)
            stroke.Color = state and Color3.fromRGB(unpack(Config.ThemeColor)) or Color3.fromRGB(45, 45, 55)
            if state then
                glowTween:Play()
            else
                glowTween:Cancel()
                stroke.Thickness = 1.5
            end
        end
        RefreshVisual()

        -- PERBAIKAN: drag & klik digabung di clickBtn (dia paling atas, jadi dia yang
        -- beneran nerima sentuhan/klik duluan -- kalau drag dipasang di frame di bawahnya, nggak kepanggil)
        local dragging, dragInput, dragStart, startPos, moved

        clickBtn.InputBegan:Connect(function(input)
            if locked then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                moved = false
                dragStart = input.Position
                startPos = frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        if moved and Config.Shortcuts[name] then
                            -- Snap-to-edge: kalau posisi akhir deket banget pinggir layar, nempelin ke pinggirnya
                            local viewport = workspace.CurrentCamera.ViewportSize
                            local absPos = frame.AbsolutePosition
                            local absSize = frame.AbsoluteSize
                            local SNAP_MARGIN = 24
                            local finalX = absPos.X
                            local finalY = absPos.Y

                            if finalX <= SNAP_MARGIN then
                                finalX = 4
                            elseif finalX + absSize.X >= viewport.X - SNAP_MARGIN then
                                finalX = viewport.X - absSize.X - 4
                            end
                            if finalY <= SNAP_MARGIN then
                                finalY = 4
                            elseif finalY + absSize.Y >= viewport.Y - SNAP_MARGIN then
                                finalY = viewport.Y - absSize.Y - 4
                            end

                            local snappedPos = UDim2.new(0, finalX, 0, finalY)
                            TweenService:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = snappedPos}):Play()

                            Config.Shortcuts[name].pos = {0, finalX, 0, finalY}
                            SaveConfig()
                        end
                    end
                end)
            end
        end)

        clickBtn.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        local dragConn = TrackConnection(UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging and not locked then
                local delta = input.Position - dragStart
                if delta.Magnitude > 6 then moved = true end
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end))

        clickBtn.MouseButton1Click:Connect(function()
            if moved then return end -- ini hasil geser, bukan tap biasa -> skip toggle
            PlayClickSound()
            toggleFn()
            RefreshVisual()
        end)

        ActiveShortcuts[name] = {frame = frame, conn = dragConn}
    end

    -- Dipasang ke Frame apapun (misalnya ToggleFrame) supaya tap/klik TAHAN 0.5 detik
    -- munculin/hilangin mini shortcut button-nya. Jalan otomatis di HP (jari) & PC (mouse).
    local function AttachLongPressShortcut(hostFrame, name, icon, isOnFn, toggleFn)
        local pressToken = nil
        local longPressFired = false

        hostFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local myToken = {}
                pressToken = myToken
                longPressFired = false
                task.delay(0.5, function()
                    if pressToken == myToken then
                        longPressFired = true
                        ToggleShortcutButton(name, icon, isOnFn, toggleFn)
                    end
                end)
            end
        end)

        hostFrame.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                pressToken = nil
            end
        end)

        -- dipanggil oleh tombol utama (mis. Switch) supaya tau apakah harus skip klik normal
        return function()
            if longPressFired then
                longPressFired = false
                return true -- skip klik normal
            end
            return false
        end
    end

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    local TargetPosition = UDim2.new(0.5, -Config.Width/2, 0.45, -Config.Height/2)
    local TargetSize = UDim2.new(0, Config.Width, 0, Config.Height)
    -- Mulai dari kecil & transparan di tengah target, nanti di-tween ke ukuran asli (loading animation)
    MainFrame.Position = UDim2.new(0.5, 0, 0.45, 0)
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.BackgroundTransparency = 1
    MainFrame.Active = true
    MainFrame.ClipsDescendants = true

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 14)
    MainCorner.Parent = MainFrame

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Color3.fromRGB(unpack(Config.ThemeColor))
    MainStroke.Thickness = 1.8
    MainStroke.Parent = MainFrame
    RegisterThemedColor(function()
        MainStroke.Color = Color3.fromRGB(unpack(Config.ThemeColor))
    end)

    local BgImageLabel = Instance.new("ImageLabel")
    BgImageLabel.Name = "BgImageLabel"
    BgImageLabel.Parent = MainFrame
    BgImageLabel.Size = UDim2.new(1, 0, 1, 0)
    BgImageLabel.BackgroundTransparency = 1
    BgImageLabel.Image = Config.BgImage
    BgImageLabel.ImageTransparency = 0.75
    BgImageLabel.ScaleType = Enum.ScaleType.Crop

    local TopBar = Instance.new("Frame")
    TopBar.Name = "TopBar"
    TopBar.Parent = MainFrame
    TopBar.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    TopBar.BackgroundTransparency = Config.BgImage ~= "" and 0.2 or 0
