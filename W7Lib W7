            OptionHolder.Position = UDim2.new(0, 0, 0, COLLAPSED_HEIGHT)
            OptionHolder.Size = UDim2.new(1, 0, 0, OPTION_HEIGHT * #optionsList)
            OptionHolder.Parent = DropdownFrame

            local OptionList = Instance.new("UIListLayout")
            OptionList.Padding = UDim.new(0, 2)
            OptionList.HorizontalAlignment = Enum.HorizontalAlignment.Center
            OptionList.SortOrder = Enum.SortOrder.LayoutOrder
            OptionList.Parent = OptionHolder

            local optionCheckMap = {}

            local function GetSelectedArray()
                local arr = {}
                for _, opt in ipairs(optionsList) do
                    if selected[opt] then table.insert(arr, opt) end
                end
                return arr
            end

            local function RefreshSelectedText()
                local arr = GetSelectedArray()
                if #arr == 0 then
                    SelectedBtn.Text = "Pilih...  v"
                elseif #arr <= 2 then
                    SelectedBtn.Text = table.concat(arr, ", ") .. "  v"
                else
                    SelectedBtn.Text = #arr .. " dipilih  v"
                end
            end

            local function RefreshChecks()
                for opt, checkLabel in pairs(optionCheckMap) do
                    checkLabel.Text = selected[opt] and "[x]" or "[ ]"
                    checkLabel.TextColor3 = selected[opt] and GetAccent() or Color3.fromRGB(150, 150, 155)
                end
            end

            local function ToggleOption(opt)
                if selected[opt] then
                    selected[opt] = nil
                else
                    selected[opt] = true
                end
                RefreshChecks()
                RefreshSelectedText()
                SafeFire(text, callback, GetSelectedArray())
            end

            for _, opt in ipairs(optionsList) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Size = UDim2.new(0.9, 0, 0, OPTION_HEIGHT - 3)
                OptBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
                OptBtn.Text = ""
                OptBtn.Parent = OptionHolder

                local OBCorner = Instance.new("UICorner")
                OBCorner.CornerRadius = UDim.new(0, 4)
                OBCorner.Parent = OptBtn

                local CheckLabel = Instance.new("TextLabel")
                CheckLabel.BackgroundTransparency = 1
                CheckLabel.Size = UDim2.new(0, 26, 1, 0)
                CheckLabel.Position = UDim2.new(0, 4, 0, 0)
                CheckLabel.Font = Enum.Font.GothamBold
                CheckLabel.Text = selected[opt] and "[x]" or "[ ]"
                CheckLabel.TextColor3 = selected[opt] and GetAccent() or Color3.fromRGB(150, 150, 155)
                CheckLabel.TextSize = 11
                CheckLabel.TextXAlignment = Enum.TextXAlignment.Left
                CheckLabel.Parent = OptBtn

                local OptLabel = Instance.new("TextLabel")
                OptLabel.BackgroundTransparency = 1
                OptLabel.Size = UDim2.new(1, -30, 1, 0)
                OptLabel.Position = UDim2.new(0, 28, 0, 0)
                OptLabel.Font = Enum.Font.Gotham
                OptLabel.Text = tostring(opt)
                OptLabel.TextColor3 = Color3.fromRGB(200, 200, 205)
                OptLabel.TextSize = 11
                OptLabel.TextXAlignment = Enum.TextXAlignment.Left
                OptLabel.Parent = OptBtn

                OptBtn.MouseButton1Click:Connect(function()
                    PlayClickSound()
                    ToggleOption(opt)
                end)

                optionCheckMap[opt] = CheckLabel
            end

            RefreshSelectedText()

            SelectedBtn.MouseButton1Click:Connect(function()
                PlayClickSound()
                expanded = not expanded
                local targetHeight = expanded and (COLLAPSED_HEIGHT + OPTION_HEIGHT * #optionsList + 6) or COLLAPSED_HEIGHT
                TweenService:Create(DropdownFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.94, 0, 0, targetHeight)}):Play()
            end)

            if not options.AccentColor then
                RegisterThemedColor(function()
                    SelectedBtn.TextColor3 = GetAccent()
                    RefreshChecks()
                end)
            end
            if not options.PanelColor then
                RegisterThemedColor(function() DropdownFrame.BackgroundColor3 = GetPanelColor() end)
            end

            RegisterState(text,
                function() return GetSelectedArray() end,
                function(v)
                    selected = {}
                    if type(v) == "table" then
                        for _, opt in ipairs(v) do selected[opt] = true end
                    end
                    RefreshChecks()
                    RefreshSelectedText()
                end,
                defaultSelected
            )

            table.insert(ElementsLibrary, {Name = text, Instance = DropdownFrame})
        end

