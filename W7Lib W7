            local function MakeChannelSlider(labelText, yPos, channelKey)
                local Row = Instance.new("Frame")
                Row.BackgroundTransparency = 1
                Row.Size = UDim2.new(0.92, 0, 0, 26)
                Row.Position = UDim2.new(0.04, 0, 0, yPos)
                Row.Parent = PickerFrame

                local RLabel = Instance.new("TextLabel")
                RLabel.Size = UDim2.new(0, 16, 1, 0)
                RLabel.BackgroundTransparency = 1
                RLabel.Font = Enum.Font.GothamBold
                RLabel.Text = labelText
                RLabel.TextColor3 = Color3.fromRGB(200, 200, 205)
                RLabel.TextSize = 11
                RLabel.Parent = Row

                local Track = Instance.new("TextButton")
                Track.Size = UDim2.new(1, -30, 0, 5)
                Track.Position = UDim2.new(0, 20, 0.5, -2)
                Track.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                Track.Text = ""
                Track.Parent = Row

                local TCorner = Instance.new("UICorner")
                TCorner.CornerRadius = UDim.new(1, 0)
                TCorner.Parent = Track

                local Fill = Instance.new("Frame")
                Fill.Size = UDim2.new(color[channelKey] / 255, 0, 1, 0)
                Fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                Fill.BorderSizePixel = 0
                Fill.Parent = Track

                local FCorner = Instance.new("UICorner")
                FCorner.CornerRadius = UDim.new(1, 0)
                FCorner.Parent = Fill

                local function ApplyFillFromColor()
                    Fill.Size = UDim2.new(color[channelKey] / 255, 0, 1, 0)
                end
                table.insert(channelRefreshers, ApplyFillFromColor)

                local sliding = false
                local function UpdateChannel(input)
                    local ratio = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    color[channelKey] = math.floor(ratio * 255)
                    Fill.Size = UDim2.new(ratio, 0, 1, 0)
                    Preview.BackgroundColor3 = Color3.fromRGB(color.r, color.g, color.b)
                    FireCallback()
                end
                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true; UpdateChannel(input)
                    end
                end)
                TrackConnection(UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateChannel(input)
                    end
                end))
                Track.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
            end

            MakeChannelSlider("R", 44, "r")
            MakeChannelSlider("G", 74, "g")
            MakeChannelSlider("B", 104, "b")

            ArrowBtn.MouseButton1Click:Connect(function()
                PlayClickSound()
                expanded = not expanded
                ArrowBtn.Text = expanded and "^" or "v"
                local targetHeight = expanded and EXPANDED_HEIGHT or COLLAPSED_HEIGHT
                TweenService:Create(PickerFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.94, 0, 0, targetHeight)}):Play()
            end)

            if not options.PanelColor then
                RegisterThemedColor(function() PickerFrame.BackgroundColor3 = GetPanelColor() end)
            end

            RegisterState(text,
                function() return {r = color.r, g = color.g, b = color.b} end,
                function(v)
                    if type(v) == "table" then
                        color = {r = v.r, g = v.g, b = v.b}
                        Preview.BackgroundColor3 = Color3.fromRGB(color.r, color.g, color.b)
                        for _, refresh in ipairs(channelRefreshers) do refresh() end
                        FireCallback()
                    end
                end,
                defaultValue
            )

            table.insert(ElementsLibrary, {Name = text, Instance = PickerFrame})
        end

        -- ================================
        -- CreateConsole: Debug Console Mini -- nampilin log dari Window:Log() + error otomatis
        -- ================================
        function TabFunctions:CreateConsole(lineCount)
            lineCount = lineCount or 8

            local ConsoleFrame = Instance.new("Frame")
            ConsoleFrame.Name = "DebugConsole"
            ConsoleFrame.Size = UDim2.new(0.94, 0, 0, 22 * lineCount + 16)
            ConsoleFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
            ConsoleFrame.Parent = Page

            local CCorner = Instance.new("UICorner")
            CCorner.CornerRadius = UDim.new(0, 6)
            CCorner.Parent = ConsoleFrame

            local CStroke = Instance.new("UIStroke")
            CStroke.Color = Color3.fromRGB(40, 40, 50)
            CStroke.Parent = ConsoleFrame

            local LogScroll = Instance.new("ScrollingFrame")
            LogScroll.BackgroundTransparency = 1
            LogScroll.Position = UDim2.new(0, 6, 0, 6)
            LogScroll.Size = UDim2.new(1, -12, 1, -12)
            LogScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
            LogScroll.ScrollBarThickness = 3
            LogScroll.Parent = ConsoleFrame

            local LogList = Instance.new("UIListLayout")
            LogList.Padding = UDim.new(0, 2)
            LogList.SortOrder = Enum.SortOrder.LayoutOrder -- KRUSIAL, tanpa ini urutan log bakal alfabetis bukan urutan waktu kejadian
            LogList.Parent = LogScroll

            LogList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                LogScroll.CanvasSize = UDim2.new(0, 0, 0, LogList.AbsoluteContentSize.Y + 4)
                LogScroll.CanvasPosition = Vector2.new(0, math.max(0, LogList.AbsoluteContentSize.Y - LogScroll.AbsoluteSize.Y))
            end)

            local LEVEL_COLOR = {
                info = Color3.fromRGB(210, 210, 215),
                warn = Color3.fromRGB(255, 200, 60),
                error = Color3.fromRGB(255, 90, 90)
            }

            local function AddLine(logText, level)
                local Line = Instance.new("TextLabel")
                Line.BackgroundTransparency = 1
                Line.Size = UDim2.new(1, 0, 0, 16)
                Line.AutomaticSize = Enum.AutomaticSize.Y
                Line.Font = Enum.Font.Code
                Line.Text = "[" .. os.date("%H:%M:%S") .. "] " .. logText
                Line.TextColor3 = LEVEL_COLOR[level] or LEVEL_COLOR.info
                Line.TextSize = 10
                Line.TextXAlignment = Enum.TextXAlignment.Left
                Line.TextWrapped = true
                Line.Parent = LogScroll

                -- batasin jumlah baris yang ditampilin biar nggak numpuk selamanya
                local children = LogScroll:GetChildren()
                local labelCount = 0
                for _, c in ipairs(children) do
                    if c:IsA("TextLabel") then labelCount += 1 end
                end
                if labelCount > lineCount * 3 then
                    for _, c in ipairs(children) do
                        if c:IsA("TextLabel") then c:Destroy(); break end
                    end
                end
            end

            -- muatin log yang udah kejadian sebelum console ini dibuat
            for _, entry in ipairs(LogEntries) do
                AddLine(entry.text, entry.level)
            end

            table.insert(LogListeners, function(logText, level)
                AddLine(logText, level)
            end)

            table.insert(ElementsLibrary, {Name = "DebugConsole", Instance = ConsoleFrame})
        end

        -- ================================
        -- CreateSliderGroup: beberapa slider mini nyatu 1 frame, expand/collapse (mirip ColorPicker tapi angka bebas)
        -- sliders = {{name="X", min=0, max=100, default=50}, {name="Y", min=0, max=100, default=50}, ...}
        -- callback dipanggil dengan table {X=.., Y=..} tiap ada slider yang berubah
        -- ================================
        function TabFunctions:CreateSliderGroup(text, sliders, callback, options)
            options = options or {}
            callback = callback or function() end
            sliders = sliders or {}

            local values = {} -- [name] = {min=, max=, value=}
            local names = {}
            local defaultSnapshot = {}

            for _, def in ipairs(sliders) do
                local minV = def.min or 0
                local maxV = def.max or 100
                if not maxV or maxV <= minV then maxV = minV + 1 end
                local defV = math.clamp(def.default or minV, minV, maxV)
                table.insert(names, def.name)
                values[def.name] = {min = minV, max = maxV, value = defV}
                defaultSnapshot[def.name] = defV
            end

            local saved = Config.SavedFeatures[text]
            if type(saved) == "table" then
                for name, v in pairs(saved) do
                    if values[name] then
                        values[name].value = math.clamp(v, values[name].min, values[name].max)
                    end
                end
            end

            local function GetAccent()
                return options.AccentColor or Color3.fromRGB(unpack(Config.ThemeColor))
            end
            local function GetPanelColor()
                return options.PanelColor or Color3.fromRGB(unpack(Config.PanelColor))
            end

            local ROW_HEIGHT = 30
            local COLLAPSED_HEIGHT = 40
            local EXPANDED_HEIGHT = COLLAPSED_HEIGHT + (#names * ROW_HEIGHT) + 10
            local expanded = false

            local GroupFrame = Instance.new("Frame")
            GroupFrame.Name = text
            GroupFrame.ClipsDescendants = true
            GroupFrame.Size = UDim2.new(0.94, 0, 0, COLLAPSED_HEIGHT)
            GroupFrame.BackgroundColor3 = GetPanelColor()
            GroupFrame.BackgroundTransparency = Config.BgImage ~= "" and 0.4 or 0
            GroupFrame.Parent = Page

            local GCorner = Instance.new("UICorner")
            GCorner.CornerRadius = UDim.new(0, 6)
            GCorner.Parent = GroupFrame

            local GStroke = Instance.new("UIStroke")
            GStroke.Color = Color3.fromRGB(45, 45, 55)
            GStroke.Parent = GroupFrame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.5, 0, 0, 36)
            Label.Position = UDim2.new(0.04, 0, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Font = Enum.Font.GothamMedium
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(230, 230, 230)
            Label.TextSize = 12
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = GroupFrame

            local ArrowBtn = Instance.new("TextButton")
            ArrowBtn.Size = UDim2.new(0, 28, 0, 24)
            ArrowBtn.Position = UDim2.new(1, -40, 0, 6)
            ArrowBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
            ArrowBtn.Font = Enum.Font.GothamBold
            ArrowBtn.Text = "v"
            ArrowBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            ArrowBtn.TextSize = 12
            ArrowBtn.Parent = GroupFrame

            local ACorner = Instance.new("UICorner")
            ACorner.CornerRadius = UDim.new(1, 0)
            ACorner.Parent = ArrowBtn

            local function FireCallback()
                local snapshot = {}
                for _, name in ipairs(names) do snapshot[name] = values[name].value end
                SafeFire(text, callback, snapshot)
            end

            local rowRefreshers = {} -- dipanggil pas load state, biar visual (fill+label) ikut ke-update
            local accentRefs = {} -- {Fill=, ValueLabel=} tiap baris, buat live theme update

            local function MakeRow(name, yPos)
                local def = values[name]
                local Row = Instance.new("Frame")
                Row.BackgroundTransparency = 1
                Row.Size = UDim2.new(0.92, 0, 0, ROW_HEIGHT - 4)
                Row.Position = UDim2.new(0.04, 0, 0, yPos)
                Row.Parent = GroupFrame

                local RLabel = Instance.new("TextLabel")
                RLabel.Size = UDim2.new(0, 46, 1, 0)
                RLabel.BackgroundTransparency = 1
                RLabel.Font = Enum.Font.GothamBold
                RLabel.Text = name
                RLabel.TextColor3 = Color3.fromRGB(200, 200, 205)
                RLabel.TextSize = 11
                RLabel.TextXAlignment = Enum.TextXAlignment.Left
                RLabel.Parent = Row

                local ValueLabel = Instance.new("TextLabel")
                ValueLabel.Size = UDim2.new(0, 36, 1, 0)
                ValueLabel.Position = UDim2.new(1, -36, 0, 0)
                ValueLabel.BackgroundTransparency = 1
                ValueLabel.Font = Enum.Font.GothamBold
                ValueLabel.Text = tostring(def.value)
                ValueLabel.TextColor3 = GetAccent()
                ValueLabel.TextSize = 11
                ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
                ValueLabel.Parent = Row

                local Track = Instance.new("TextButton")
                Track.Size = UDim2.new(1, -90, 0, 5)
                Track.Position = UDim2.new(0, 46, 0.5, -2)
                Track.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                Track.Text = ""
                Track.Parent = Row

                local TCorner = Instance.new("UICorner")
                TCorner.CornerRadius = UDim.new(1, 0)
                TCorner.Parent = Track

                local Fill = Instance.new("Frame")
                Fill.Size = UDim2.new((def.value - def.min) / (def.max - def.min), 0, 1, 0)
                Fill.BackgroundColor3 = GetAccent()
                Fill.BorderSizePixel = 0
                Fill.Parent = Track

                local FCorner = Instance.new("UICorner")
                FCorner.CornerRadius = UDim.new(1, 0)
                FCorner.Parent = Fill

                table.insert(accentRefs, {Fill = Fill, ValueLabel = ValueLabel})

                local function ApplyFromValue()
                    local ratio = (def.value - def.min) / (def.max - def.min)
                    Fill.Size = UDim2.new(ratio, 0, 1, 0)
                    ValueLabel.Text = tostring(def.value)
                end
                table.insert(rowRefreshers, ApplyFromValue)

                local sliding = false
                local function UpdateRow(input)
                    local ratio = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    def.value = math.floor(def.min + (def.max - def.min) * ratio)
                    ValueLabel.Text = tostring(def.value)
                    Fill.Size = UDim2.new(ratio, 0, 1, 0)
                    FireCallback()
                end
                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true; UpdateRow(input)
                    end
                end)
                TrackConnection(UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateRow(input)
                    end
                end))
                Track.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
            end

            for i, name in ipairs(names) do
                MakeRow(name, COLLAPSED_HEIGHT + (i - 1) * ROW_HEIGHT)
            end

            ArrowBtn.MouseButton1Click:Connect(function()
                PlayClickSound()
                expanded = not expanded
                ArrowBtn.Text = expanded and "^" or "v"
                local targetHeight = expanded and EXPANDED_HEIGHT or COLLAPSED_HEIGHT
                TweenService:Create(GroupFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.94, 0, 0, targetHeight)}):Play()
            end)

            if not options.AccentColor then
                RegisterThemedColor(function()
                    for _, ref in ipairs(accentRefs) do
                        ref.Fill.BackgroundColor3 = GetAccent()
                        ref.ValueLabel.TextColor3 = GetAccent()
                    end
                end)
            end
            if not options.PanelColor then
                RegisterThemedColor(function() GroupFrame.BackgroundColor3 = GetPanelColor() end)
            end

            RegisterState(text,
                function()
                    local snapshot = {}
                    for _, name in ipairs(names) do snapshot[name] = values[name].value end
                    return snapshot
                end,
                function(v)
                    if type(v) == "table" then
                        for name, val in pairs(v) do
                            if values[name] then
                                values[name].value = math.clamp(val, values[name].min, values[name].max)
                            end
                        end
                        for _, refresh in ipairs(rowRefreshers) do refresh() end
                        FireCallback()
                    end
                end,
                defaultSnapshot
            )

            table.insert(ElementsLibrary, {Name = text, Instance = GroupFrame})
        end

        -- ================================
        -- CreateRangeSlider: 1 track, 2 handle (low & high) -- buat pilih rentang, misal "Damage 10-50"
        -- callback dipanggil dengan (low, high)
        -- ================================
        function TabFunctions:CreateRangeSlider(text, min, max, defaultLow, defaultHigh, callback, options)
            options = options or {}
            callback = callback or function() end
            min = min or 0
            if not max or max <= min then max = min + 1 end
            local lowV = math.clamp(defaultLow or min, min, max)
            local highV = math.clamp(defaultHigh or max, min, max)
            if lowV > highV then lowV, highV = highV, lowV end
            local defaultSnapshot = {low = lowV, high = highV}

            local saved = Config.SavedFeatures[text]
            if type(saved) == "table" and saved.low and saved.high then
                lowV = math.clamp(saved.low, min, max)
                highV = math.clamp(saved.high, min, max)
            end

            local function GetAccent()
                return options.AccentColor or Color3.fromRGB(unpack(Config.ThemeColor))
            end
            local function GetPanelColor()
                return options.PanelColor or Color3.fromRGB(unpack(Config.PanelColor))
            end

            local RangeFrame = Instance.new("Frame")
            RangeFrame.Name = text
            RangeFrame.Size = UDim2.new(0.94, 0, 0, 50)
            RangeFrame.BackgroundColor3 = GetPanelColor()
            RangeFrame.BackgroundTransparency = Config.BgImage ~= "" and 0.4 or 0
            RangeFrame.Parent = Page

            local RCorner = Instance.new("UICorner")
            RCorner.CornerRadius = UDim.new(0, 6)
