    -- ================================
    -- CONFIG PROFILE (banyak preset, misal "Farm Mode" vs "PVP Mode")
    -- ================================
    -- Simpan state SEKARANG sebagai preset baru bernama "name". Timpa kalau nama sama udah ada.
    function WindowFunctions:SaveProfile(name)
        if not name or name == "" then return end
        local snapshot = {SavedFeatures = {}, ThemeColor = Config.ThemeColor, PanelColor = Config.PanelColor}
        for featureName, entry in pairs(StateRegistry) do
            snapshot.SavedFeatures[featureName] = entry.get()
        end
        Config.Profiles[name] = snapshot
        SaveConfig()
        self:Notify("Profile Tersimpan", "Preset \"" .. name .. "\" berhasil disimpan.", 3)
    end

    -- Terapin preset "name" ke semua fitur + tema sekarang
    function WindowFunctions:LoadProfile(name)
        local profile = Config.Profiles[name]
        if not profile then
            self:Notify("Gagal", "Preset \"" .. tostring(name) .. "\" nggak ditemukan.", 3)
            return
        end
        if profile.ThemeColor then Config.ThemeColor = profile.ThemeColor end
        if profile.PanelColor then Config.PanelColor = profile.PanelColor end
        for _, refresh in ipairs(ThemeRegistry) do pcall(refresh) end

        for featureName, value in pairs(profile.SavedFeatures or {}) do
            local entry = StateRegistry[featureName]
            if entry then
                entry.set(value)
                Config.SavedFeatures[featureName] = value
            end
        end
        SaveConfig()
        self:Notify("Profile Dimuat", "Preset \"" .. name .. "\" berhasil diterapkan.", 3)
    end

    -- Daftar semua nama preset yang ada, buat ditampilin di Dropdown misalnya
    function WindowFunctions:ListProfiles()
        local names = {}
        for name in pairs(Config.Profiles) do
            table.insert(names, name)
        end
        return names
    end

    function WindowFunctions:DeleteProfile(name)
        if Config.Profiles[name] then
            Config.Profiles[name] = nil
            SaveConfig()
            self:Notify("Profile Dihapus", "Preset \"" .. name .. "\" udah dihapus.", 3)
        end
    end

    -- ================================
    -- IMPORT / EXPORT CONFIG (kayak "kode voucher" biar bisa dipindah ke device/orang lain)
    -- ================================
    -- Bikin 1 string JSON dari snapshot config sekarang. Coba otomatis ke clipboard
    -- (kalau executor dukung setclipboard), kalau nggak return string-nya biar ditampilin manual.
    function WindowFunctions:ExportConfig()
        local snapshot = {SavedFeatures = {}, ThemeColor = Config.ThemeColor, PanelColor = Config.PanelColor}
        for featureName, entry in pairs(StateRegistry) do
            snapshot.SavedFeatures[featureName] = entry.get()
        end

        local ok, str = pcall(function() return HttpService:JSONEncode(snapshot) end)
        if not ok then
            self:Notify("Export Gagal", "Config nggak bisa di-encode.", 3)
            return nil
        end

        local copied = false
        if setclipboard then
            copied = pcall(setclipboard, str)
        end

        if copied then
            self:Notify("Config Ter-copy", "Kode config udah masuk clipboard, tinggal paste.", 3)
        else
            self:Notify("Export Siap", "Clipboard nggak kedetek, copy manual dari string yang di-return.", 4)
        end

        return str
    end

    -- Terapin balik string hasil ExportConfig(). Return true kalau berhasil, false + alasan kalau gagal.
    function WindowFunctions:ImportConfig(str)
        local ok, snapshot = pcall(function() return HttpService:JSONDecode(str) end)
        if not ok or type(snapshot) ~= "table" then
            self:Notify("Import Gagal", "Kode config nggak valid / rusak.", 4)
            return false
        end

        if snapshot.ThemeColor then Config.ThemeColor = snapshot.ThemeColor end
        if snapshot.PanelColor then Config.PanelColor = snapshot.PanelColor end
        for _, refresh in ipairs(ThemeRegistry) do pcall(refresh) end

        for featureName, value in pairs(snapshot.SavedFeatures or {}) do
            local entry = StateRegistry[featureName]
            if entry then
                entry.set(value)
                Config.SavedFeatures[featureName] = value
            end
        end
        SaveConfig()
        self:Notify("Config Dimuat", "Kode config berhasil diterapkan.", 3)
        return true
    end

