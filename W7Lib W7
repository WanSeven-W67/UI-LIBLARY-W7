                    local ratio = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    color[channelKey] = math.floor(ratio * 255)
                    Fill.Size = UDim2.new(ratio, 0, 1, 0)
                    Preview.BackgroundColor3 = Color3.fromRGB(color.r, color.g, color.b)
                    if state then Switch.BackgroundColor3 = Color3.fromRGB(color.r, color.g, color.b) end
                    FireCallback()
                end
                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true; UpdateChannel(input)
                    end
                end)
                TrackConnection(UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateChannel(input)
                    end
                end))
                Track.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
            end

            MakeChannelSlider("R", 44, "r")
            MakeChannelSlider("G", 74, "g")
            MakeChannelSlider("B", 104, "b")

            local ConsumeIfLongPress = AttachLongPressShortcut(HybridFrame, text, "⭐", function() return state end, function()
                SetToggleState(not state)
            end)

            Switch.MouseButton1Click:Connect(function()
                if ConsumeIfLongPress() then return end
                PlayClickSound(not state and "on" or "off")
                SetToggleState(not state)
            end)

            ArrowBtn.MouseButton1Click:Connect(function()
                PlayClickSound()
                expanded = not expanded
                ArrowBtn.Text = expanded and "^" or "v"
                local targetHeight = expanded and EXPANDED_HEIGHT or COLLAPSED_HEIGHT
                TweenService:Create(HybridFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.94, 0, 0, targetHeight)}):Play()
            end)

            if not options.PanelColor then
                RegisterThemedColor(function() HybridFrame.BackgroundColor3 = GetPanelColor() end)
            end

            RegisterState(text,
                function() return {on = state, color = {r = color.r, g = color.g, b = color.b}} end,
                function(v)
                    if type(v) == "table" then
                        state = v.on
                        if v.color then color = {r = v.color.r, g = v.color.g, b = v.color.b} end
                        ApplyToggleVisual()
                        Preview.BackgroundColor3 = Color3.fromRGB(color.r, color.g, color.b)
                        for _, refresh in ipairs(channelRefreshers) do refresh() end
                        FireCallback()
                    end
                end,
                {on = defaultToggle, color = defaultColorValue}
            )

            table.insert(ElementsLibrary, {Name = text, Instance = HybridFrame})
        end

        return TabFunctions
    end

    function WindowFunctions:SetBackgroundImage(assetId)
        Config.BgImage = "rbxassetid://" .. tostring(assetId:match("%d+"))
        BgImageLabel.Image = Config.BgImage
        TopBar.BackgroundTransparency = 0.2
        TabContainer.BackgroundTransparency = 0.4
        SaveConfig()
    end

    function WindowFunctions:DestroyGUI()
        for _, conn in ipairs(connections) do
            pcall(function() conn:Disconnect() end)
        end

        local tweens = TweenService:GetPlayingTweens()
        for _, tween in ipairs(tweens) do
            pcall(function() tween:Cancel() end)
        end

        for _, entry in pairs(ActiveShortcuts) do
            pcall(function()
                if entry.conn then entry.conn:Disconnect() end
                entry.frame:Destroy()
            end)
        end

        if antiAFKConn then antiAFKConn:Disconnect(); antiAFKConn = nil end

        WatermarkUI:Destroy()
        NotifyGui:Destroy()
        ScreenGui:Destroy()
    end

    -- Loading animation: GUI muncul dengan fade + scale in, bukan langsung "muncul dor"
    TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = TargetPosition,
        Size = TargetSize,
        BackgroundTransparency = 0
    }):Play()

    return WindowFunctions
end
return W7Lib
