                local hitBtn = Instance.new("TextButton")
                hitBtn.Size = UDim2.new(0, 28, 0, 28)
                hitBtn.AnchorPoint = Vector2.new(0.5, 0.5)
                hitBtn.Position = UDim2.new(0.5, 0, 0.5, 0)
                hitBtn.BackgroundTransparency = 1
                hitBtn.Text = ""
                hitBtn.ZIndex = 4
                hitBtn.Parent = handle

                local dragging = false
                hitBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                    end
                end)
                hitBtn.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
                TrackConnection(UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local ratio = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                        local newVal = math.floor(min + (max - min) * ratio)
                        if isLow then
                            lowV = math.min(newVal, highV)
                        else
                            highV = math.max(newVal, lowV)
                        end
                        LowHandle.Position = UDim2.new(ratioOf(lowV), 0, 0.5, 0)
                        HighHandle.Position = UDim2.new(ratioOf(highV), 0, 0.5, 0)
                        RefreshVisual()
                        SafeFire(text, callback, lowV, highV)
                    end
                end))
            end

            MakeHandleDraggable(LowHandle, true)
            MakeHandleDraggable(HighHandle, false)

            if not options.AccentColor then
                RegisterThemedColor(function()
                    FillBetween.BackgroundColor3 = GetAccent()
                    ValueLabel.TextColor3 = GetAccent()
                end)
            end
            if not options.PanelColor then
                RegisterThemedColor(function() RangeFrame.BackgroundColor3 = GetPanelColor() end)
            end

            RegisterState(text,
                function() return {low = lowV, high = highV} end,
                function(v)
                    if type(v) == "table" then
                        lowV = math.clamp(v.low, min, max)
                        highV = math.clamp(v.high, min, max)
                        LowHandle.Position = UDim2.new(ratioOf(lowV), 0, 0.5, 0)
                        HighHandle.Position = UDim2.new(ratioOf(highV), 0, 0.5, 0)
                        RefreshVisual()
                    end
                end,
                defaultSnapshot
            )

            table.insert(ElementsLibrary, {Name = text, Instance = RangeFrame})
        end

